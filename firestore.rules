rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Event slots: público pode consultar e decrementar vagas ao agendar
    match /events/{eventSlug}/slots/{slotId} {
      allow read: if true;
      allow write: if true;
    }

    // Event RSVPs: apenas autenticados listam todos; público pode checar o próprio número e criar
    match /events/{eventSlug}/rsvps/{rsvpId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.resource.data.nome is string
                    && request.resource.data.whatsapp is string
                    && request.resource.data.horario is string;
      allow update, delete: if request.auth != null;
    }
  }
}