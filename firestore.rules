rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Event slots: public can read availability and update capacity during booking
    match /events/{eventSlug}/slots/{slotId} {
      allow read: if true;
      allow write: if true;
    }

    // Event RSVPs: only authenticated users can list all RSVPs; public can check a specific phone and create
    match /events/{eventSlug}/rsvps/{rsvpId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.resource.data.nome is string
                    && request.resource.data.whatsapp is string
                    && request.resource.data.horario is string;
      allow update, delete: if request.auth != null;
    }
  }
}
